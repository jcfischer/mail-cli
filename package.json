{
  "name": "mail-cli",
  "version": "1.0.0",
  "description": "Email CLI: IMAP/SMTP mail with multiple accounts and markdown support",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun run scripts/build.ts",
    "clean": "rm -f email",
    "smoke:dependencies": "bun run scripts/smoke-dependencies.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --max-concurrency=1",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "apache-arrow": "17.0.0",
    "commander": "^12.1.0",
    "date-fns": "^3.0.0",
    "drizzle-orm": "^0.29.0",
    "imapflow": "^1.1.1",
    "mailparser": "^3.7.1",
    "marked": "^14.1.3",
    "nodemailer": "^6.9.16",
    "resona": "0.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/imap": "^0.8.40",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^6.4.17",
    "typescript": "5"
  },
  "keywords": [
    "email",
    "smtp",
    "cli",
    "markdown"
  ],
  "author": "Jens-Christian Fischer",
  "license": "MIT"
}
