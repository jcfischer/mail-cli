#!/usr/bin/env bash
# Disposable test mail server for the email CLI: a local GreenMail IMAP/SMTP
# server in a container, with one invented account and a sandbox home.
#
# Never point this at a real account. The server keeps mail in memory, so
# `down` (or a container restart) discards every message.
#
# Usage:
#   scripts/test-mailbox up       start the server, create Drafts, write the sandbox config
#   scripts/test-mailbox home     print the sandbox home path
#   scripts/test-mailbox env      print the shell line that points the CLI at the sandbox
#   scripts/test-mailbox status   say whether the server answers
#   scripts/test-mailbox down     stop and remove the server
#
# Run the CLI against it:
#   HOME="$(scripts/test-mailbox home)" ./email draft lookup req-1 -o json
#
# Inspect Drafts with any IMAP client: 127.0.0.1:3143, no TLS,
# user "test", password "secret".

set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
STATE="${MAIL_CLI_TEST_STATE:-$HOME/.local/state/mail-cli/test-mailbox}"
SANDBOX="$STATE/home"
CONTAINER=mail-cli-test-mailbox
IMAGE=greenmail/standalone:2.1.2
IMAP_PORT=3143
SMTP_PORT=3025
USER_NAME=test
USER_PASS=secret
ADDRESS=test@example.invalid
RD_BIN="/Applications/Rancher Desktop.app/Contents/Resources/resources/darwin/bin"

die() { echo "test-mailbox: $*" >&2; exit 1; }

find_docker() {
  if command -v docker >/dev/null 2>&1; then echo docker; return; fi
  for d in "$HOME/.rd/bin/docker" "$RD_BIN/docker"; do
    [ -x "$d" ] && { echo "$d"; return; }
  done
  die "no docker CLI found (install Rancher Desktop or Docker)"
}

ensure_engine() {
  "$DOCKER" info >/dev/null 2>&1 && return
  if [ -x "$RD_BIN/rdctl" ]; then
    echo "test-mailbox: starting Rancher Desktop" >&2
    "$RD_BIN/rdctl" start --container-engine.name=moby --kubernetes.enabled=false \
      --application.start-in-background >/dev/null 2>&1 || true
  fi
  for _ in $(seq 1 60); do
    "$DOCKER" info >/dev/null 2>&1 && return
    sleep 3
  done
  die "container engine did not answer within 3 minutes"
}

imap_answers() {
  nc -z 127.0.0.1 "$IMAP_PORT" >/dev/null 2>&1
}

write_config() {
  mkdir -p "$SANDBOX/.config/email"
  cat > "$SANDBOX/.config/email/config.json" <<EOF
{
  "defaultAccount": "test",
  "accounts": {
    "test": {
      "name": "test",
      "from": { "name": "Test Mailbox", "email": "$ADDRESS" },
      "smtp": { "host": "127.0.0.1", "port": $SMTP_PORT, "secure": false,
                "auth": { "user": "$USER_NAME", "pass": "$USER_PASS" } },
      "imap": { "enabled": true, "host": "127.0.0.1", "port": $IMAP_PORT, "tls": false,
                "auth": { "user": "$USER_NAME", "pass": "$USER_PASS" }, "mailboxes": ["INBOX"] }
    }
  }
}
EOF
  chmod 600 "$SANDBOX/.config/email/config.json"
}

create_drafts() {
  (cd "$REPO" && bun -e "
    const { ImapFlow } = await import('imapflow');
    const c = new ImapFlow({ host: '127.0.0.1', port: $IMAP_PORT, secure: false,
      auth: { user: '$USER_NAME', pass: '$USER_PASS' }, logger: false });
    await c.connect();
    const boxes = await c.list();
    if (!boxes.some((b) => b.path === 'Drafts')) await c.mailboxCreate('Drafts');
    await c.logout();
  ")
}

# Run the CLI itself against the sandbox, so a config the CLI cannot read fails here.
check_cli() {
  local answer
  answer="$(HOME="$SANDBOX" bun run "$REPO/src/index.ts" draft lookup test-mailbox-check -o json 2>/dev/null)" ||
    die "the CLI could not use the sandbox config: $answer"
  [ "$answer" = '{"status":"not_found"}' ] || die "unexpected CLI answer from the sandbox: $answer"
}

cmd="${1:-}"
case "$cmd" in
  up)
    DOCKER="$(find_docker)"
    ensure_engine
    if ! "$DOCKER" ps --format '{{.Names}}' | grep -qx "$CONTAINER"; then
      "$DOCKER" rm -f "$CONTAINER" >/dev/null 2>&1 || true
      "$DOCKER" run -d --name "$CONTAINER" \
        -p "127.0.0.1:$IMAP_PORT:3143" -p "127.0.0.1:$SMTP_PORT:3025" \
        -e GREENMAIL_OPTS="-Dgreenmail.setup.test.all -Dgreenmail.hostname=0.0.0.0 -Dgreenmail.users=$USER_NAME:$USER_PASS@example.invalid -Dgreenmail.verbose=false" \
        "$IMAGE" >/dev/null
    fi
    for _ in $(seq 1 40); do imap_answers && break; sleep 1; done
    imap_answers || die "IMAP did not answer on 127.0.0.1:$IMAP_PORT"
    for _ in $(seq 1 10); do create_drafts 2>/dev/null && break; sleep 1; done
    create_drafts
    write_config
    check_cli
    echo "test-mailbox: up (IMAP 127.0.0.1:$IMAP_PORT, user $USER_NAME, account \"test\")"
    echo "test-mailbox: run the CLI with HOME=$SANDBOX"
    ;;
  home)
    echo "$SANDBOX"
    ;;
  env)
    echo "export HOME=\"$SANDBOX\""
    ;;
  status)
    if imap_answers; then echo "up"; else echo "down"; exit 1; fi
    ;;
  down)
    DOCKER="$(find_docker)"
    "$DOCKER" rm -f "$CONTAINER" >/dev/null 2>&1 || true
    echo "test-mailbox: down"
    ;;
  *)
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    [ -z "$cmd" ] || exit 2
    ;;
esac
